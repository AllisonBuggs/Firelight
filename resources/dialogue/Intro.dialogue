~ start
do wait(8)
do textLabel.text = "My heart is warm with pastries from a species unloving. Confusion has left me emotional."
do playAnimation("fadeText", extraanimations, true)
do queenSpeak()
do wait(8)
do playAnimation("fadeText", extraanimations, false)
do wait(3)
do playAnimation("Playerin", backgroundPlayer, false)
do wait(2.2)
do playAnimation("struggle", extraanimations, false)
do playAnimation("Idle", backgroundPlayer, false)
do wait(4)
do textLabel.text = "I Crave my views vaildation."
do playAnimation("fadeText", extraanimations, true)
do queenSpeak()
do wait(8)
do playAnimation("fadeText", extraanimations, false)
do wait(3)
do textLabel.text = "You will be my vessel for observation."
do playAnimation("fadeText", extraanimations, true)
do queenSpeak()
do wait(8)
do playAnimation("fadeText", extraanimations, false)
do wait(3)
do playAnimation("observerintro", extraanimations, false)
do wait(2)
do playAnimation("observerimplant", extraanimations, false)
do wait(2)
do playAnimation("stringyleave", extraanimations, false)
do wait(2)
do textLabel.text = "You are only a child, you appeal to humanity's sympathies to its young."
do playAnimation("fadeText", extraanimations, true)
do queenSpeak()
do wait(8)
do playAnimation("fadeText", extraanimations, false)
do wait(3)
do textLabel.text = "Prove that you are capable, reach the daylight and we may begin properly."
do playAnimation("fadeText", extraanimations, true)
do queenSpeak()
do wait(8)
do playAnimation("fadeText", extraanimations, false)
do wait(3)
do fadeOut()
do playAnimation("struggle", extraanimations, false)
do wait(0.5) 
do playAnimation("struggle", extraanimations, false)
do wait(0.5)
do playAnimation("Playerin", backgroundPlayer, true)
do wait(8)
do changeScene("res://resources/scenes/maps/LabLowerFloor.tscn")
=> END