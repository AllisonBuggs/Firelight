~ start
do freezePlayer()
if Player.instance.inventoryContents.has("Crowbar") == true:
	do playSound("res://resources/sfx/WoodSnap5.ogg")
	do unlockClosetDoor()
	do destory(find_closest(actionables), actionables)
	You: The door is now open.
else
	You: The door is rammed shut, you need something to pry it open.
do unfreezePlayer()
=> END